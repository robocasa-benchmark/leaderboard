{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RoboCasa Agentic Leaderboard Submission",
    "type": "object",
    "required": [
        "model_name",
        "model_type",
        "submitter",
        "date",
        "robocasa_version",
        "atomic_seen_success",
        "composite_seen_success",
        "composite_unseen_success",
        "base_policy",
        "code_url",
        "commit_hash",
        "paper_link",
        "open_source",
        "notes"
    ],
    "if": {
        "properties": {
            "open_source": {
                "const": "yes"
            }
        }
    },
    "then": {
        "required": [
            "checkpoint_url"
        ]
    },
    "properties": {
        "model_name": {
            "type": "string",
            "minLength": 1
        },
        "model_type": {
            "type": "string",
            "enum": ["VLA", "WAM", "VLA + WM", "Visuomotor", "Other"]
        },
        "submitter": {
            "type": "string",
            "minLength": 1
        },
        "submitter_url": {
            "type": "string",
            "minLength": 1
        },
        "date": {
            "type": "string",
            "format": "date"
        },
        "robocasa_version": {
            "type": "string",
            "minLength": 1
        },
        "atomic_seen_success": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
        },
        "composite_seen_success": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
        },
        "composite_unseen_success": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
        },
        "base_policy": {
            "type": "string",
            "minLength": 1
        },
        "code_url": {
            "type": "string",
            "minLength": 1
        },
        "commit_hash": {
            "type": "string",
            "minLength": 1
        },
        "checkpoint_url": {
            "type": "string",
            "minLength": 1
        },
        "paper_link": {
            "type": "string",
            "minLength": 1
        },
        "open_source": {
            "type": "string",
            "enum": [
                "yes",
                "no"
            ]
        },
        "training_config": {
            "type": "object",
            "required": [
                "batch_size",
                "num_training_steps"
            ],
            "properties": {
                "batch_size": {
                    "type": "integer",
                    "minimum": 1
                },
                "num_training_steps": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "additionalProperties": false
        },
        "notes": {
            "type": "string",
            "minLength": 1
        }
    },
    "additionalProperties": false
}
